# Discord credentials — get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_test_server_id_here

# PostgreSQL connection (running on your Proxmox box)
DATABASE_URL=postgres://botuser:password@192.168.1.x:5432/discordbot

# Anthropic API key for the chat feature — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Riot API for League of Legends features — https://developer.riotgames.com
# RIOT_CLUSTER: regional routing for account/match data (americas | asia | europe)
# RIOT_PLATFORM: platform routing for live games/ranks (na1, euw1, kr, etc.)
RIOT_API_KEY=your_riot_api_key_here
RIOT_CLUSTER=americas
RIOT_PLATFORM=na1
